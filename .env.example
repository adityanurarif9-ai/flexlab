# Salin menjadi .env. Jangan commit .env atau membagikan password SMTP.
PORT=4317
COMFYUI_URL=http://127.0.0.1:8188
# Default lokal: .workflows/image.json dan .workflows/video.json
# FLEXLAB_WORKFLOW_IMAGE=.workflows/image.json
# FLEXLAB_WORKFLOW_VIDEO=.workflows/video.json
# Kunci akun otomatis dibuat di .flexlab/auth-secret. Jangan hapus saat akun dipakai.
# BETTER_AUTH_SECRET=isi_kunci_acak_minimal_32_karakter
# SMTP_HOST=smtp.penyedia-emailmu.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=alamat-emailmu
# SMTP_PASS=password_aplikasi_email
# SMTP_FROM=FlexLab <alamat-emailmu>
# Mode uji email OFF secara default. npm run dev:email menyalakannya secara eksplisit.
